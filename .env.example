# Production values are configured with Sites runtime secrets; never commit real values.
DEEPSEEK_API_KEY=
BEAUTYPROOF_TEST_TOKEN=
# Keep local paid requests disabled. Live tests share the production D1 budget ledger.
BEAUTYPROOF_PAID_ENABLED=false
# Optional authenticated ECS public-page reader. Private key is PKCS8 DER base64.
# Leave BOTH empty to use the original read path. Never expose these to the client.
BEAUTYPROOF_READER_URL=
BEAUTYPROOF_READER_PRIVATE_KEY=
# Asynchronous anonymous reader, enabled only after an ECS-to-site real test.
# Public key is SPKI DER base64; the matching private key stays on ECS.
BEAUTYPROOF_READER_PUBLIC_KEY=
BEAUTYPROOF_ANONYMOUS_READER_ENABLED=false
# Alternative v2 path: Sites submits signed HTTPS jobs to an ICP-compliant ECS endpoint.
# Keep this disabled until the domain, TLS, ECS service and end-to-end test are verified.
# Enabling it selects inbound mode instead of the outbound bridge above.
BEAUTYPROOF_XHS_INBOUND_ENABLED=false
BEAUTYPROOF_XHS_INBOUND_URL=
BEAUTYPROOF_XHS_INBOUND_PRIVATE_KEY=
